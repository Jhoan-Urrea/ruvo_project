rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE APOYO ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isModerator() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MODERATOR';
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. USUARIOS: Perfil público legible, escritura privada y gamificación protegida
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (request.resource.data.role == resource.data.role) ||
                   isModerator() ||
                   (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'level', 'badges', 'totalReviews', 'rating']));
    }

    // 2. SERVICIOS: Lectura pública, escritura protegida con validación de IA
    match /services_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isModerator() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'rating', 'reviewsCount'])) ||
        (request.auth.uid == resource.data.authorId &&
          // El autor no puede marcar como VERIFICADO si el score de confianza es bajo.
          (request.resource.data.status != 'VERIFICADO' || request.resource.data.trustScore > 80)
        )
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isModerator());
    }

    // 3. MENSAJERÍA: Privacidad total entre participantes
    match /conversations/{convId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      }
    }

    // 4. NOTIFICACIONES: Privacidad absoluta del destinatario
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.receiverId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // 5. SOLICITUDES DE SERVICIO: Privacidad entre cliente y proveedor y supervisión de moderadores
    match /service_requests/{requestId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.providerId ||
        isModerator()
      );
    }

    // 6. REPORTES: Solo creación y lectura del autor o moderador
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isModerator());
      allow update: if isModerator();
    }

    // 7. RESEÑAS: Lectura pública y creación por parte del cliente autenticado
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow delete: if isModerator();
    }

    // 8. COMENTARIOS: Lectura pública y creación por usuarios autenticados
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isModerator());
    }

    // BLOQUEO GLOBAL
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
